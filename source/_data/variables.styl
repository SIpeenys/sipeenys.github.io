// ============================================================
// 深灰配色 · 六便士的世界
// 通过 custom_file_path.variable 覆盖 NexT 主题 Stylus 变量
// 如需调整颜色，直接修改下方色值即可
// ============================================================

// --- 基础灰色色板（由深到浅） ---
$whitesmoke   = #2e3136;   // 卡片 / 菜单背景
$gainsboro    = #34373c;   // 次要背景（搜索栏头部等）
$grey-lighter = #3d4147;   // 边框 / 分隔线
$grey-light   = #44484e;   // 边框强调
$grey         = #555a61;
$grey-dark    = #6b7078;   // 图标 / 次要文字
$grey-dim     = #9aa1a9;   // 弱化文字
$black-light  = #cfd3d8;   // 正文文字
$black-dim    = #b9bfc7;
$black-deep   = #e4e7ea;   // 标题 / 强调文字
$blue-deep    = #8b9096;   // 选中背景
$orange       = #a8b0b8;   // 侧边栏高亮（统一灰调）

// --- 文本与链接 ---
$text-color                = $black-light;
$link-color                = #aeb7c0;
$link-hover-color          = #eef1f3;
$link-decoration-color     = #5f646b;
$blockquote-color          = #aab1b8;

// --- 背景 ---
$body-bg-color             = #232529;   // 页面最外层背景
$content-bg-color          = #2b2d31;   // 内容卡片背景
$card-bg-color             = #2e3136;
$menu-item-bg-color        = #2b2d31;

// --- 选中 ---
$selection-bg              = #3d4147;
$selection-color           = #e4e7ea;

// --- 品牌（站名） ---
$brand-color               = #e4e7ea;
$brand-hover-color         = #ffffff;
$subtitle-color            = #8b9096;   // 副标题

// --- 表格 ---
$table-border-color             = #3d4147;
$table-cell-border-bottom-color = #3d4147;
$table-row-odd-bg-color         = #26282c;
$table-row-hover-bg-color       = #33363b;

// --- 按钮 ---
$btn-default-bg                 = #3d4147;
$btn-default-color              = #cfd3d8;
$btn-default-border-color       = #4a4f56;
$btn-default-hover-bg           = #4a4f56;
$btn-default-hover-color        = #ffffff;
$btn-default-hover-border-color = #5a5f66;

// --- 分页 ---
$pagination-border            = #3d4147;
$pagination-link-border       = #3d4147;
$pagination-active-bg         = #4a4f56;
$pagination-active-border     = #4a4f56;
